<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="database.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1836"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="preguntas" custom_title="0" dock_id="1" table="4,9:mainpreguntas"/><dock_state state="000000ff00000000fd00000001000000020000039100000260fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003910000012900ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="niveles" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="52"/><column index="2" value="86"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="preguntas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="77"/><column index="2" value="300"/><column index="3" value="103"/><column index="4" value="103"/><column index="5" value="95"/><column index="6" value="120"/><column index="7" value="37"/><column index="8" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Nivel 3: Sumas y restas con llevadas
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('¿Cuánto es 46 + 37?', '83', '73', '84', 1, 3, 'Suma unidades: 6+7=13, lleva 1 a las decenas'),
('¿Cuánto es 92 - 48?', '44', '54', '46', 1, 3, 'Resta unidades: 12-8=4 (presta 1 a las decenas)'),
('¿Cuánto es 57 + 69?', '126', '116', '136', 1, 3, 'Suma unidades: 7+9=16, lleva 1 a las decenas');

-- Nivel 4: Multiplicaciones básicas
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('¿Cuánto es 6 × 7?', '42', '49', '36', 1, 4, '6×6=36, más 6'),
('¿Cuánto es 8 × 9?', '72', '81', '63', 1, 4, '8×8=64, más 8'),
('¿Cuánto es 5 × 12?', '60', '50', '70', 1, 4, '5×10=50, más 5×2=10');

-- Nivel 5: Divisiones exactas
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('¿Cuánto es 56 ÷ 8?', '7', '8', '6', 1, 5, '8 × 7 = 56'),
('¿Cuánto es 72 ÷ 9?', '8', '9', '7', 1, 5, '9 × 8 = 72'),
('¿Cuánto es 49 ÷ 7?', '7', '6', '8', 1, 5, '7 × 7 = 49');

-- Nivel 6: Fracciones básicas
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('¿Cuánto es 2/3 de 12?', '8', '6', '9', 1, 6, 'Divide 12 ÷ 3 = 4, luego multiplica por 2'),
('¿Qué fracción es mayor: 3/4 o 2/3?', '3/4', '2/3', 'Son iguales', 1, 6, 'Convierte a denominador común: 9/12 vs 8/12'),
('Simplifica 4/8', '1/2', '2/4', '1/4', 1, 6, 'Divide numerador y denominador entre 4');

-- Nivel 7: Geometría básica
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('¿Cuántos lados tiene un hexágono?', '6', '5', '7', 1, 7, 'Hexa = 6 en griego'),
('¿Perímetro de un cuadrado de 5 cm de lado?', '20 cm', '15 cm', '25 cm', 1, 7, 'Multiplica 5 × 4'),
('¿Cuántas aristas tiene un cubo?', '12', '8', '6', 1, 7, 'Cada cara tiene 4 aristas, pero se comparten');

-- Nivel 8: Medidas y unidades
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('¿Cuántos metros hay en 1 kilómetro?', '1000', '100', '10', 1, 8, 'Kilo = mil'),
('¿Cuántos segundos hay en 1 hora?', '3600', '60', '360', 1, 8, '60 segundos × 60 minutos'),
('Convierte 2.5 litros a mililitros', '2500', '250', '25', 1, 8, '1 litro = 1000 mililitros');

-- Nivel 9: Problemas de lógica
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('Si ayer fue lunes, ¿qué día será en 3 días?', 'Jueves', 'Viernes', 'Miércoles', 2, 9, 'Hoy es martes, cuenta 3 días'),
('Tengo 15 dulces y como 1/3. ¿Cuántos quedan?', '10', '5', '12', 1, 9, '15 ÷ 3 = 5, réstalo'),
('Un bus tiene 24 asientos. Si 3/4 están ocupados, ¿cuántos vacíos hay?', '6', '8', '18', 1, 9, '24 × 1/4 = 6');

-- Nivel 10: Problemas complejos
INSERT INTO preguntas (pregunta, respuesta1, respuesta2, respuesta3, respuesta_correcta, nivel, ayuda) VALUES
('Ana compra 3 libros a $15 c/u y 2 cuadernos a $5 c/u. Total?', '$55', '$45', '$65', 1, 10, '3×15 + 2×5 = 45+10'),
('Un rectángulo mide el doble de largo que de ancho. Perímetro 30 cm, ¿largo?', '10 cm', '5 cm', '15 cm', 1, 10, 'Ancho=x, largo=2x → 2(x+2x)=30'),
('Carlos ahorra $10 semanales. ¿Cuánto en 6 meses (24 semanas)?', '$240', '$200', '$120', 1, 10, '10 × 24 = 240');</sql><current_tab id="0"/></tab_sql></sqlb_project>
